{
  "name": "datn-agent",
  "version": "1.0.0",
  "description": "Remote PC control agent for DATN server",
  "main": "dist/tray/tray.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "start:tray": "electron dist/tray/tray.js",
    "tray:dev": "electron .",
    "service:install": "node dist/service/install.js",
    "service:uninstall": "node dist/service/uninstall.js",
    "package:exe": "pkg . --targets node20-win-x64 --out-path build",
    "clean": "rimraf dist build",
    "benchmark:realtime": "ts-node scripts/benchmark-realtime.ts"
  },
  "bin": "dist/main.js",
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      "node_modules/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "build"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@roamhq/wrtc": "^0.10.0",
    "dotenv": "^17.4.2",
    "node-datachannel": "^0.32.2",
    "node-windows": "^1.0.0-beta.8",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^32.0.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
