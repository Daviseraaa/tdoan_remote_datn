{
  "manifest_version": 3,
  "name": "StationHub Agent Bridge",
  "version": "1.0.0",
  "description": "Đọc DOM và thao tác tab Chrome cho StationHub Agent (Native Messaging).",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content/stationhub-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "StationHub Agent Bridge",
    "default_popup": "popup.html"
  }
}
