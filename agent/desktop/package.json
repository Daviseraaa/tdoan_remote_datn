{
  "name": "datn-agent-desktop",
  "version": "1.0.0",
  "description": "DATN Agent — desktop control panel (config, tray, service)",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-static.js",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "service:install": "node dist/service/install.js",
    "service:uninstall": "node dist/service/uninstall.js"
  },
  "build": {
    "appId": "com.datn.agent.desktop",
    "productName": "DATN Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../bin/datn-agent-native.exe",
        "to": "core/datn-agent-native.exe"
      },
      {
        "from": "../bin/cloak",
        "to": "cloak",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3"
  }
}
