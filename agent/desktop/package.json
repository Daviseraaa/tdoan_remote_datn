{
  "name": "stationhub-agent-desktop",
  "version": "1.0.0",
  "author": "StationHub",
  "description": "StationHub Agent — desktop control panel (config, tray, service)",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-static.js",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "service:install": "node dist/service/install.js",
    "service:uninstall": "node dist/service/uninstall.js"
  },
  "build": {
    "appId": "com.stationhub.agent.desktop",
    "productName": "StationHub Agent",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.ico",
    "afterPack": "scripts/after-pack-icon.js",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../bin/stationhub-agent-native.exe",
        "to": "core/stationhub-agent-native.exe"
      },
      {
        "from": "../bin/cloak",
        "to": "cloak",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "shortcutName": "StationHub Agent"
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2",
    "typescript": "^5.7.3"
  }
}
