# Server WebSocket endpoint (use wss:// in production)
SERVER_WS_URL=ws://localhost:3000

# Agent authentication key (obtained after POST /api/agents)
AGENT_KEY=a1c5b20d-5140-4700-849e-a844f03edde1

# Heartbeat interval (milliseconds)
HEARTBEAT_INTERVAL_MS=30000

# Default command timeout (milliseconds)
COMMAND_TIMEOUT_MS=300000

# Max output size returned to server (bytes)
MAX_OUTPUT_BYTES=1000000

# Shell: 'powershell' or 'cmd'
DEFAULT_SHELL=powershell

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Remote realtime tuning ---
# Bật/tắt DataChannel cho control (true/false). Tắt => fallback socket.
REMOTE_DATACHANNEL_ENABLED=true
# Bật/tắt adaptive FPS policy theo telemetry.
REMOTE_ADAPTIVE_ENABLED=true
# Bật/tắt thu thập telemetry (RTT/loss/jitter + capture timing).
REMOTE_TELEMETRY_ENABLED=true
# Chu kỳ log telemetry (ms).
REMOTE_TELEMETRY_INTERVAL_MS=10000
# FPS mục tiêu, min, max, bước thay đổi.
REMOTE_TARGET_FPS=10
REMOTE_MIN_FPS=3
REMOTE_MAX_FPS=20
REMOTE_FPS_STEP=2
# Hysteresis: thời gian tối thiểu giữa 2 lần đổi FPS (ms).
REMOTE_ADAPTIVE_COOLDOWN_MS=4000
# Ngưỡng mạng để tăng/giảm FPS.
REMOTE_GOOD_RTT_MS=80
REMOTE_BAD_RTT_MS=200
REMOTE_GOOD_LOSS=0.01
REMOTE_BAD_LOSS=0.05
# TTL cache screen dimension cho input mapping (ms).
REMOTE_SCREEN_CACHE_MS=5000

# Video pipeline: software | ffmpeg
REMOTE_VIDEO_PIPELINE=software
# Media engine: wrtc | ndc
REMOTE_MEDIA_ENGINE=wrtc
# ffmpeg executable path
REMOTE_FFMPEG_PATH=ffmpeg
# Preferred hardware encoder: auto | nvenc | amf | qsv
REMOTE_H264_PREFERRED_ENCODER=auto
# Encoder target ranges
REMOTE_H264_MIN_BITRATE_KBPS=800
REMOTE_H264_MAX_BITRATE_KBPS=4500
REMOTE_H264_BITRATE_STEP_KBPS=300
REMOTE_H264_KEYINT=60
REMOTE_H264_PRESET=p4
# Adaptive scale (1.0 = full resolution)
REMOTE_SCALE_MIN=0.5
REMOTE_SCALE_MAX=1.0
REMOTE_SCALE_STEP=0.1

# Runtime quality profile: low-latency | balanced | high-quality
REMOTE_QUALITY_PROFILE=balanced
# Preferred region hint for TURN selection
REMOTE_PREFERRED_REGION=sg
# Dirty tile diff
REMOTE_TILE_DIFF_ENABLED=true
REMOTE_TILE_SIZE=64
REMOTE_TILE_DIFF_THRESHOLD=22
# Gói RGBA tile patch qua DataChannel `tilepatch` (chỉ wrtc + pipeline software)
REMOTE_TILE_PATCH_ENABLED=true
REMOTE_TILE_PATCH_MAX_TILES=48
REMOTE_TILE_PATCH_MAX_BYTES_PER_SEC=1500000
