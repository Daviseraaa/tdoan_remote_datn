# Production: desktop app ghi vào %ProgramData%\DATN\agent.env
# Dev: copy thành agent/.env hoặc chỉnh trong Cài đặt (tray)

# --- Kết nối server ---
SERVER_WS_URL=ws://localhost:3000
AGENT_KEY=your-agent-key-from-post-api-agents
# AGENT_VERSION=1.1.0

# Public IP cho telemetry heartbeat (optional)
# PUBLIC_IP_LOOKUP_URL=https://api.ipify.org

# --- Task / shell ---
COMMAND_TIMEOUT_MS=300000
MAX_OUTPUT_BYTES=1000000
DEFAULT_SHELL=powershell
TASK_MAX_CONCURRENCY=1

# --- Desktop (Electron tray log) ---
LOG_LEVEL=info

# --- Desktop automation (mặc định TẮT — chỉ bật máy tin cậy, session user) ---
DESKTOP_AUTOMATION_ENABLED=false
# DESKTOP_AUTOMATION_MAX_STEPS=200
# DESKTOP_AUTOMATION_MAX_DELAY_MS=60000
# DESKTOP_AUTOMATION_MAX_TYPE_CHARS=8000

# --- Mở app (Windows: chờ cửa sổ GUI, ms 1000–60000) ---
# OPEN_APP_WINDOW_WAIT_MS=15000
