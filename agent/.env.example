# Production: desktop app ghi vào %ProgramData%\StationHub\agent.env
# Dev: copy thành agent/.env hoặc chỉnh trong Cài đặt (tray)

# --- Kết nối server ---
# SERVER_WS_URL, AGENT_VERSION, PUBLIC_IP_LOOKUP_URL, LOG_LEVEL: cố định trong
# desktop/src/shared/build-config.ts (không ghi agent.env).
AGENT_KEY=your-agent-key-from-post-api-agents

# --- Task / shell ---
COMMAND_TIMEOUT_MS=300000
MAX_OUTPUT_BYTES=1000000
DEFAULT_SHELL=powershell
# Số task chạy đồng thời trên 1 agent (1–32). Workflow đa nhánh dùng chung agentId → tăng (vd. 2+) để các nhánh thực sự song song trên một máy.
# Số task chạy song song trên một agent (tăng khi nhiều workflow flow dùng chung agent)
TASK_MAX_CONCURRENCY=5

# --- Desktop automation (mặc định TẮT — chỉ bật máy tin cậy, session user) ---
DESKTOP_AUTOMATION_ENABLED=false
# DESKTOP_AUTOMATION_MAX_STEPS=200
# DESKTOP_AUTOMATION_MAX_DELAY_MS=60000
# DESKTOP_AUTOMATION_MAX_TYPE_CHARS=8000

# --- Chụp màn hình (SCREEN_CAPTURE task) ---
SCREEN_CAPTURE_ENABLED=true
# Ảnh mặc định: %ProgramData%\StationHub\captures\{taskId}.png

# --- Mở app (Windows: chờ cửa sổ GUI, ms 1000–60000) ---
# OPEN_APP_WINDOW_WAIT_MS=15000

# --- OPEN_BROWSER (CloakBrowser hoặc Chrome hệ thống) ---
# OPEN_BROWSER_HEADLESS=false
# OPEN_BROWSER_HUMANIZE=true
# OPEN_BROWSER_KEEP_OPEN=true
# Cloak profile (khi admin chọn Cloak trên workflow — không set useChromeProfile trong payload)
OPEN_BROWSER_PROFILE_DIR=C:\ProgramData\StationHub\browser-profiles\default
# Cloak vs Chrome: cấu hình trên admin workflow payload (useChromeProfile), không qua env agent
# CLOAK_RUNNER_PYTHON=pythonw
# CLOAK_RUNNER_DIR=C:\path\to\stationhub-cloak-runner

# --- Chrome extension bridge (CHROME_EXTENSION task) ---
# CHROME_EXTENSION_ENABLED=false
# CHROME_EXTENSION_MAX_STEPS=50
# CHROME_EXTENSION_MAX_NODES=500
# CHROME_EXTENSION_ALLOWED_URLS=
# CLOAK_RUNNER_PYTHON=python
# CLOAKBROWSER_CACHE_DIR=C:\ProgramData\StationHub\cloak-cache

# --- Remote (RustDesk) — cấu hình trong tray Cài đặt → tab Remote ---
# RUSTDESK_EXE_PATH=C:\Program Files\RustDesk\rustdesk.exe
# RUSTDESK_ID=
# RUSTDESK_PASSWORD=
