# NestJS REST API (admin-requirements.md)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000

# Google Sign-In — cùng Client ID với GOOGLE_CLIENT_ID trên server
# Safari redirect: thêm Authorized redirect URI trên Google Cloud Console:
#   {VITE_API_BASE_URL}/auth/google/redirect
VITE_GOOGLE_CLIENT_ID=
