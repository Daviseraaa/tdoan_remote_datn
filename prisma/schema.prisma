generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum AgentStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum TaskType {
  COMMAND
  SCRIPT
  FILE_OPERATION
  SYSTEM_INFO
  OPEN_APP
  OPEN_BROWSER
  CLOSE_APP
  DESKTOP_AUTOMATION
  CHROME_EXTENSION
  SCREEN_CAPTURE
  HTTP_REQUEST
  TELEGRAM_SEND
}

enum TaskStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
  CANCELLED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

enum StepType {
  COMMAND
  SCRIPT
  DELAY
  CONDITION
  LOOP
  VARIABLE
  EXCEL
  TELEGRAM
}

enum WorkflowTriggerType {
  MANUAL
  SCHEDULE
  TELEGRAM
}

enum ScheduleKind {
  CRON
  INTERVAL
  DAILY
  HOURLY
  ONCE
}

enum TriggerExecutionStatus {
  STARTED
  COMPLETED
  FAILED
  SKIPPED
}

enum OnFailure {
  STOP
  SKIP
  RETRY
}

enum RemoteSessionStatus {
  PENDING
  ACTIVE
  ENDED
  FAILED
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum FlowRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  STOPPED
}

enum StepRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentProvider {
  SEPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  /** Giá niêm yết (VND). Bằng priceVnd thì không hiển thị giảm giá. */
  originalPriceVnd Int
  /** Giá bán thực tế (VND) — dùng khi checkout. */
  priceVnd     Int
  durationDays Int      @default(30)
  maxAgents    Int      @default(3)
  description  String?
  /** Danh sách quyền lợi hiển thị trên trang Billing (JSON string[]). Rỗng = dùng mặc định. */
  benefits     Json?
  isActive     Boolean  @default(true)
  /** Gói trial — chỉ gán khi đăng ký, không bán qua checkout */
  isTrial      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users    User[]
  payments Payment[]

  @@map("subscription_plans")
}

model Payment {
  id                 String          @id @default(uuid())
  userId             String
  planId             String
  amountVnd          Int
  provider           PaymentProvider @default(SEPAY)
  status             PaymentStatus   @default(PENDING)
  orderCode          BigInt          @unique
  paymentCode        String          @unique
  sepayTransactionId String?         @unique
  paidAt             DateTime?
  expiresAt          DateTime?
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  googleId  String?  @unique
  name      String
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  subscriptionExpiresAt DateTime?
  planId                String?
  trialUsedAt           DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan           SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments       Payment[]
  agents         Agent[]
  tasks          Task[]
  taskTemplates  TaskTemplate[]
  chromeScripts      ChromeScript[]
  desktopRecordings  DesktopRecording[]
  workflows      Workflow[]
  workflowRuns   WorkflowRun[]
  telegramBots   TelegramBot[]
  workflowTriggers WorkflowTrigger[]
  remoteSessions RemoteSession[] @relation("RemoteOperator")

  @@index([subscriptionStatus])
  @@index([subscriptionExpiresAt])
  @@map("users")
}

model Agent {
  id         String      @id @default(uuid())
  name       String
  agentKey   String      @unique @default(uuid())
  status     AgentStatus @default(OFFLINE)
  os         String?
  hostname   String?
  ip         String?
  metadata       Json?
  chromeProfiles Json?
  lastSeenAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks          Task[]
  taskTemplates  TaskTemplate[]
  chromeScripts      ChromeScript[]
  desktopRecordings  DesktopRecording[]
  remoteSessions RemoteSession[]

  @@index([userId])
  @@index([status])
  @@map("agents")
}

model DesktopRecording {
  id        String   @id @default(uuid())
  name      String
  steps     Json
  source    String   @default("recorded")
  localId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId String?
  agent   Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([userId, agentId, localId], name: "desktop_recording_agent_local")
  @@index([userId])
  @@index([agentId])
  @@map("desktop_recordings")
}

model ChromeScript {
  id        String   @id @default(uuid())
  name      String
  startUrl  String?
  steps     Json
  source    String   @default("recorded")
  localId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId String?
  agent   Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([userId, agentId, localId], name: "chrome_script_agent_local")
  @@index([userId])
  @@index([agentId])
  @@map("chrome_scripts")
}

model TaskTemplate {
  id        String   @id @default(uuid())
  name      String
  type      TaskType
  command   String
  payload   Json?
  timeout   Int      @default(300000)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agentId])
  @@map("task_templates")
}

model Task {
  id          String     @id @default(uuid())
  type        TaskType
  command     String?
  payload     Json?
  status      TaskStatus @default(PENDING)
  result      String?    @db.Text
  exitCode    Int?
  priority    Int        @default(0)
  retryCount  Int        @default(0)
  maxRetries  Int        @default(3)
  timeout     Int        @default(300000) // 5 minutes in ms
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  workflowRunId String?
  workflowRun   WorkflowRun? @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)

  logs TaskLog[]

  @@index([userId])
  @@index([agentId])
  @@index([status])
  @@map("tasks")
}

model TaskLog {
  id        String   @id @default(uuid())
  level     LogLevel @default(INFO)
  message   String   @db.Text
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_logs")
}

model Workflow {
  id             String   @id @default(uuid())
  name           String
  description    String?
  variables      Json?
  graph          Json?
  graphEdges     Json?
  isActive       Boolean  @default(true)
  cronExpression String?
  stepDelayMs            Int      @default(0)
  closeOpenedOnFinish    Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  steps    WorkflowStep[]
  runs     WorkflowRun[]
  triggers WorkflowTrigger[]

  @@index([userId])
  @@map("workflows")
}

model TelegramBot {
  id            String   @id @default(uuid())
  name          String
  botToken      String
  botUsername   String?
  mode          String   @default("webhook")
  webhookSecret String?
  enabled       Boolean  @default(true)
  /** Chat ID được phép kích hoạt — mảng chuỗi; rỗng/null = mọi chat */
  allowedChatIds Json?
  /** User ID Telegram được phép — mảng chuỗi; rỗng/null = mọi user */
  allowedUserIds Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  triggers WorkflowTrigger[]

  @@index([userId])
  @@map("telegram_bots")
}

model WorkflowTrigger {
  id         String              @id @default(uuid())
  name       String?
  type       WorkflowTriggerType
  enabled    Boolean             @default(true)
  timezone   String              @default("Asia/Ho_Chi_Minh")

  scheduleKind      ScheduleKind?
  cronExpression    String?
  intervalSeconds   Int?
  runAt             DateTime?
  dailyHour         Int?
  dailyMinute       Int?
  nextRunAt         DateTime?
  lastRunAt         DateTime?
  lastRunStatus     String?
  lastWorkflowRunId String?
  maxRetries        Int               @default(0)
  retryDelaySeconds Int               @default(60)

  telegramBotId String?
  matchConfig   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId     String
  workflowId String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow   Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  telegramBot TelegramBot? @relation(fields: [telegramBotId], references: [id], onDelete: SetNull)

  executions TriggerExecution[]

  @@index([userId])
  @@index([workflowId])
  @@index([type, enabled])
  @@index([nextRunAt])
  @@index([telegramBotId])
  @@map("workflow_triggers")
}

model TriggerExecution {
  id            String                 @id @default(uuid())
  status        TriggerExecutionStatus @default(STARTED)
  payload       Json?
  error         String?                @db.Text
  startedAt     DateTime               @default(now())
  completedAt   DateTime?

  triggerId      String
  workflowRunId  String?
  trigger        WorkflowTrigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)

  @@index([triggerId])
  @@index([startedAt])
  @@map("trigger_executions")
}

model WorkflowRun {
  id          String            @id @default(uuid())
  workflowId  String
  userId      String
  status      WorkflowRunStatus @default(PENDING)
  variables   Json?
  triggerId   String?
  triggerType WorkflowTriggerType?
  triggerPayload Json?
  startedAt   DateTime          @default(now())
  completedAt DateTime?

  workflow Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  flows    WorkflowFlowRun[]
  stepRuns WorkflowStepRun[]
  tasks    Task[]

  @@index([workflowId])
  @@index([userId])
  @@index([status])
  @@map("workflow_runs")
}

model WorkflowFlowRun {
  id            String        @id @default(uuid())
  workflowRunId String
  path          String
  status        FlowRunStatus @default(PENDING)
  startedAt     DateTime      @default(now())
  completedAt   DateTime?

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@unique([workflowRunId, path])
  @@index([workflowRunId])
  @@map("workflow_flow_runs")
}

model WorkflowStepRun {
  id            String        @id @default(uuid())
  workflowRunId String
  flowPath      String?
  stepId        String
  order         Int
  status        StepRunStatus @default(PENDING)
  taskId        String?
  exitCode      Int?
  error         String?       @db.Text
  output        Json?
  depth         Int           @default(0)
  startedAt     DateTime?
  completedAt   DateTime?

  workflowRun WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)

  @@index([workflowRunId])
  @@index([stepId])
  @@index([taskId])
  @@map("workflow_step_runs")
}

model WorkflowStep {
  id        String    @id @default(uuid())
  order     Int
  type      StepType
  config    Json
  onFailure OnFailure @default(STOP)

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_steps")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model RemoteSession {
  id               String              @id @default(uuid())
  status           RemoteSessionStatus @default(PENDING)
  controlMode      String              @default("full")
  lastHeartbeatAt  DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  operatorId String
  operator   User   @relation("RemoteOperator", fields: [operatorId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@index([operatorId])
  @@map("remote_sessions")
}
