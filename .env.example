# Application
APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=datn_user
DB_PASSWORD=datn_password
DB_NAME=datn_db
DATABASE_URL=postgresql://datn_user:datn_password@localhost:5432/datn_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=datn_redis

# BullMQ task worker — số job chạy song song (workflow flows độc lập)
TASK_WORKER_CONCURRENCY=10

# Workflow triggers — Telegram webhook (bắt buộc URL public HTTPS, vd. ngrok → /api)
PUBLIC_API_BASE_URL=https://your-tunnel.example.com/api

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-this-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://100.108.185.69:5173

# Throttle (Rate Limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
