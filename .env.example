# Application
APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Telegram log forwarder (set TELEGRAM_LOG_MIN_LEVEL=trace to send every log)
TELEGRAM_LOG_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LOG_MIN_LEVEL=error
TELEGRAM_LOG_MODE=all

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=datn_user
DB_PASSWORD=datn_password
DB_NAME=datn_db
DATABASE_URL=postgresql://datn_user:datn_password@localhost:5432/datn_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=datn_redis

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-this-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://100.108.185.69:5173

# Throttle (Rate Limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# WebRTC / TURN
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USER=
WEBRTC_TURN_CREDENTIAL=
# JSON map region -> list of turn urls
# Example: {"sg":["turn:sg-turn.example.com:3478"],"jp":["turn:jp-turn.example.com:3478"]}
WEBRTC_TURN_POOLS_BY_REGION={}

# Remote runtime tuning
REMOTE_RTT_HINT_TTL_SEC=120
