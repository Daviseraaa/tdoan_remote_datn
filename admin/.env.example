VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000
# Optional: hint server/agent preferred media engine for remote session
# Supported: wrtc | ndc
VITE_REMOTE_MEDIA_ENGINE=ndc
# Optional defaults for UI selectors
VITE_REMOTE_DEFAULT_QUALITY_PROFILE=balanced
VITE_REMOTE_DEFAULT_REGION=sg
# Canvas overlay tile patch (true/false). Tắt nếu chỉ cần video.
VITE_REMOTE_TILE_PATCH_ENABLED=true
